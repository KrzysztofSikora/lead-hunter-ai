# Template for .env (never commit .env). Every variable the app reads is listed here.
# Copy to .env and adjust. Empty values count as unset.

# development | test | production (default: development)
# Under Docker Compose NODE_ENV, HOST, PORT and DATA_DIR are set by docker-compose.yml.
# NODE_ENV=development

# Address to listen on (default: 127.0.0.1). Any non-loopback address requires
# OPERATOR_PASSWORD_HASH, otherwise the app refuses to start.
# HOST=127.0.0.1

# TCP port, 1-65535 (default: 8080)
# PORT=8080

# Directory for the SQLite file lead-hunter.db (default: ./data, relative to the process cwd)
# DATA_DIR=./data

# fatal | error | warn | info | debug | trace | silent (default: info)
# LOG_LEVEL=info

# Operator password hash, format scrypt:<ln>:<r>:<p>:<salt>:<key>. Generate it with
#   pnpm auth:hash
# or, with Docker only (needs an existing, possibly empty, .env):
#   docker compose run --rm --no-deps app node apps/api/dist/cli/auth-hash.js
# and paste the printed line here. Without it the login is disabled (every protected route
# answers 401), which is acceptable only on loopback; a non-loopback HOST requires it.
OPERATOR_PASSWORD_HASH=

# Longest text accepted by one manual import, in characters, 1000-200000 (default: 20000)
# IMPORT_MAX_TEXT_CHARS=20000

# Analysis provider: mock | anthropic | openai-compatible. `mock` is a deterministic keyword
# rule set (results are labelled DEMO / MOCK). Unset means analysis is not configured: imports
# are pre-filtered and stay pending. A missing required variable below stops the start.
# LLM_PROVIDER=mock

# SECRET, never commit. Required for anthropic; optional for local OpenAI-compatible servers.
# LLM_API_KEY=

# openai-compatible only (required): base URL of the server, e.g. http://localhost:11434/v1
# anthropic: optional override of the SDK default.
# LLM_BASE_URL=

# Model for analyses. anthropic default: claude-haiku-5-5. Required for openai-compatible.
# LLM_MODEL=claude-haiku-5-5

# Model for offer drafts (read from the offer-drafts change on). anthropic default:
# claude-sonnet-5-5; openai-compatible default: LLM_MODEL.
# LLM_MODEL_OFFER=claude-sonnet-5-5

# Monthly cost cap in USD, 0.01-100000, counted per Europe/Warsaw month. A paid provider
# analyses nothing without it.
# LLM_MONTHLY_BUDGET_USD=5

# true | false. Default: true for anthropic, false for openai-compatible.
# LLM_PAID=true

# Price overrides in USD per million tokens: <model>=<input>/<output>, comma separated.
# Built in: claude-haiku-5-5, claude-sonnet-5-5. A paid model without a price is not run.
# LLM_PRICES=my-model=0.059/0.079

# openai-compatible: json_object (default) sends response_format json_object; off omits it.
# LLM_JSON_MODE=json_object

# Analyses per Europe/Warsaw day, 1-1000 (default: 20)
# ANALYSIS_DAILY_LIMIT=20

# Dated sources older than this many days are rejected by the pre-filter, 1-365 (default: 30)
# PREFILTER_MAX_AGE_DAYS=30

# One deadline for everything a URL import fetches (robots.txt, redirects, headers, body), in
# milliseconds, 1000-60000 (default: 20000)
# FETCH_TIMEOUT_MS=20000

# Largest single HTTP response body a URL import reads, in bytes, 65536-5242880 (default: 1048576)
# FETCH_MAX_BYTES=1048576

# Shortest time between two runs of one source, in minutes, 60-1440 (default: 60). Keeps the
# service polite towards the sources. A check (Sprawdź) waits 60 s since the last attempt and
# for any wait the source asked for.
# SOURCE_MIN_INTERVAL_MINUTES=60

# Requests one source run may make while the source answers 429 or 503, 1-5 (default: 3)
# SOURCE_MAX_ATTEMPTS=3

# Daily discovery runs, HH:MM in Europe/Warsaw, comma-separated, 1-6 distinct times (default:
# 08:00,18:00). 02:00-02:59 is not allowed (time change). A run missed while the app was off
# is not caught up; the next listed time runs. A `pnpm discover` that crashed in a separate
# container (`docker compose run`) frees the run lock after 2 minutes.
# DISCOVERY_TIMES=08:00,18:00
