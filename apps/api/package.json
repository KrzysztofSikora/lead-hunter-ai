{
  "name": "@lead-hunter/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --conditions=source --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "node --env-file-if-exists=../../.env --conditions=source --import tsx src/cli/migrate.ts",
    "db:generate": "drizzle-kit generate",
    "auth:hash": "node --conditions=source --import tsx src/cli/auth-hash.ts",
    "discover": "node --env-file-if-exists=../../.env --conditions=source --import tsx src/cli/discover.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.7",
    "@fastify/swagger": "9.9.2",
    "@lead-hunter/config": "workspace:*",
    "@lead-hunter/contracts": "workspace:*",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "openapi-types": "12.1.3",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "drizzle-kit": "0.31.11",
    "undici": "8.12.3"
  }
}
